    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#agrometeorologia -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#agrometeorologia">
        <CoVaMOWL-VarietyManagement:hasDescription>Ciencia que estudia las condiciones meteorológicas, climáticas e hidrológicas y su interrelación en los procesos de la producción agrícola. La Agrometeorología debe cooperar con la agricultura para utilizar mejor los recursos climáticos y luchar contra las adversidades del tiempo para obtener altos y mejores rendimientos.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Agrometeorologia</CoVaMOWL-VarietyManagement:hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#agrovoc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#agrovoc">
        <CoVaMOWL-VarietyManagement:hasVarietyType rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#content"/>
        <CoVaMOWL-VarietyManagement:hasVarietyType rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#context"/>
        <CoVaMOWL-SemanticDataManagement:hasConcept rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cHumedadAire"/>
        <CoVaMOWL-SemanticDataManagement:hasConcept rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cHumedadSuelo"/>
        <CoVaMOWL-SemanticDataManagement:hasConcept rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cPrecipitacionLiquida"/>
        <CoVaMOWL-SemanticDataManagement:hasConcept rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cTemperaturaRelativa"/>
        <CoVaMOWL-SemanticDataManagement:hasConcept rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cViento"/>
        <CoVaMOWL-VarietyManagement:hasDescription>AGROVOC es una ontología que cubre los dominios de agricultura, ciencias forestales, ganaderia, ciencias actuaticas, pesca, acuicultura y nutrición humana.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>AGROVOC</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-SemanticDataManagement:hasHomepage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://agrovoc.fao.org/</CoVaMOWL-SemanticDataManagement:hasHomepage>
        <CoVaMOWL-SemanticDataManagement:hasInternalManagement rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</CoVaMOWL-SemanticDataManagement:hasInternalManagement>
        <CoVaMOWL-SemanticDataManagement:hasQueryEndpoint rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://agrovoc.fao.org/sparql</CoVaMOWL-SemanticDataManagement:hasQueryEndpoint>
        <CoVaMOWL-SemanticDataManagement:hasQueryLanguage>SPARQL</CoVaMOWL-SemanticDataManagement:hasQueryLanguage>
        <CoVaMOWL-SemanticDataManagement:hasUriNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://aims.fao.org/aos/agrovoc/</CoVaMOWL-SemanticDataManagement:hasUriNamespace>
        <CoVaMOWL-SemanticDataManagement:hasWeight rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</CoVaMOWL-SemanticDataManagement:hasWeight>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cHumedadAire -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cHumedadAire">
        <CoVaMOWL-VarietyManagement:hasDescription>Medida de la cantidad de agua presente en el aire en comparación con la mayor cantidad posible que pueda tener el aire a una temperatura dada, expresada en porcentaje</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Humedad del Aire</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-SemanticDataManagement:hasSourceCatalog>AGROVOC</CoVaMOWL-SemanticDataManagement:hasSourceCatalog>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cHumedadSuelo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cHumedadSuelo">
        <CoVaMOWL-VarietyManagement:hasDescription>Soil-water content is the basic state characteristic of soil; it expresses the relative quantity of water in the soil. Soil-water content can be expressed as the ratio of water amount and the amount of soil.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Contenido de agua en el suelo</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-SemanticDataManagement:hasSourceCatalog>AGROVOC</CoVaMOWL-SemanticDataManagement:hasSourceCatalog>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cPrecipitacionLiquida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cPrecipitacionLiquida">
        <CoVaMOWL-VarietyManagement:hasDescription>Agua en estado líquido que cae de las nubes o se forma en la superficie de la tierra y en los objetos del suelo debido a la condensación del vapor de agua en el aire.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Lluvia</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-SemanticDataManagement:hasSourceCatalog>AGROVOC</CoVaMOWL-SemanticDataManagement:hasSourceCatalog>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cTemperaturaRelativa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cTemperaturaRelativa">
        <CoVaMOWL-VarietyManagement:hasDescription>Temperature is a physical quantity that quantitatively expresses the attribute of hotness or coldness.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Temperatura</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-SemanticDataManagement:hasSourceCatalog>AGROVOC</CoVaMOWL-SemanticDataManagement:hasSourceCatalog>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cViento -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#cViento">
        <CoVaMOWL-VarietyManagement:hasDescription>Winds are currents of air that move across the earth’s surface and develop when two adjacent air masses have different densities. The movement of air masses above the earth’s surface helps to create wind, and help to move the air masses that predict our weather.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Viento</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-SemanticDataManagement:hasSourceCatalog>AGROVOC</CoVaMOWL-SemanticDataManagement:hasSourceCatalog>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#casoApUnoCuencaMed -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#casoApUnoCuencaMed">
        <CoVaMOWL-VarietyManagement:hasDatasheetInstance rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#dsiMeteorologia"/>
        <CoVaMOWL-VarietyManagement:hasDomainCase rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#casoDominioFluctuacionesNapas"/>
        <CoVaMOWL-VarietyManagement:hasDescription>Se estudia un acuifero ubicado en la zona kárstica. Freatimetros ubicados en área suburbana dentro del campus de la universidad de Salento con vegetacion local mixta. Se consideran variables del tipo meteorologicas.</CoVaMOWL-VarietyManagement:hasDescription>
        <CoVaMOWL-VarietyManagement:hasName>Cuenca en la región mediterránea de Lecce, Italia</CoVaMOWL-VarietyManagement:hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#casoDominioFluctuacionesNapas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#casoDominioFluctuacionesNapas">
        <CoVaMOWL-VarietyManagement:hasStudyDomain rdf:resource="http://www.semanticweb.org/lara/ontologies/2026/5/CoVaMOWL-SemanticDataManagement#agrometeorologia"/>
        <CoVaMOWL-VarietyManagement:hasHypotheses>La variedad de contexto meteorologico y de entorno influye en las fluctuaciones del nivel freatico</CoVaMOWL-VarietyManagement:hasHypotheses>
        <CoVaMOWL-VarietyManagement:hasName>Factores que se relacionan con fluctuaciones de cuerpos de agua subterraneos o napas freaticas</CoVaMOWL-VarietyManagement:hasName>
        <CoVaMOWL-VarietyManagement:hasRequirements>Estudiar diferencias de efectos del clima para acuiferos ubicados en distintas zonas</CoVaMOWL-VarietyManagement:hasRequirements>
        <CoVaMOWL-VarietyManagement:hasRestrictions>Existen casos de estudio en Patagonia Norte, cuyos datos son privados (provenientes de INTA Argentina)</CoVaMOWL-VarietyManagement:hasRestrictions>
    </owl:NamedIndividual>
    


